# Variables de entorno — Germina Frontend
# Copiar a .env.local

# URL del backend (en desarrollo apunta al local vía proxy de Vite, en producción apunta a Railway)
VITE_API_URL=http://localhost:3001

# Supabase (solo cliente, claves públicas)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
