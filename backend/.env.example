# Variables de entorno — Germina Backend
# Copiar este archivo a .env y rellenar los valores reales

# Servidor (Railway lo inyecta automáticamente en producción)
PORT=3001

# Supabase — Auth + Storage + Base de datos
SUPABASE_URL=https://uifeiyyzhuhfbvysqdgr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Service Role Key (solo backend, nunca exponer al cliente)
SUPABASE_JWT_SECRET=               # JWT secret del proyecto Supabase (Settings > API)

# Base de datos Postgres (la misma instancia que usa Supabase)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# IA — OpenAI (chat principal + parser de CVs + transcripción de voz)
OPENAI_API_KEY=sk-proj-...

# CORS — URL del frontend en producción
FRONTEND_URL=https://<tu-frontend>.railway.app
